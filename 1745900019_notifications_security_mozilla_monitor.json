{
  "name": "Notifications » Security » Mozilla Monitor",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "breach-alerts@mozilla.com"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 30,
      "do": [
        {
          "type": "move",
          "target": "Notifications/Security/Mozilla Monitor"
        }
      ]
    },
    {
      "age_days_gt": 30,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard",
    "Firefox Monitor data breach alert notifications"
  ]
}