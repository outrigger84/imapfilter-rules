{
  "name": "Notifications » Finance » Xero",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "@post.xero.com"
      },
      {
        "header": "from",
        "contains": "@send.xero.com"
      },
      {
        "header": "from",
        "contains": "@identity.post.xero.com"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 30,
      "do": [
        {
          "type": "move",
          "target": "Notifications/Finance/Xero"
        }
      ]
    },
    {
      "age_days_gt": 30,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard",
    "Xero accounting login/security notifications",
    "Merged duplicate rule 1779100211_notifications_finance_xero.json (2026-08-13): added sender condition(s) ['@identity.post.xero.com']."
  ]
}