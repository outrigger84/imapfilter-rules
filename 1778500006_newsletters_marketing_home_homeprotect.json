{
  "name": "Newsletters » Marketing » Home » Homeprotect",
  "enabled": true,
  "priority": 90,
  "conditions": {
    "all": [
      {
        "any": [
          {
            "header": "from",
            "contains": "service@info.homeprotect.co.uk"
          },
          {
            "header": "from",
            "contains": "sales@homeprotect.co.uk"
          }
        ]
      },
      {
        "header": "subject",
        "not_contains": "Requested documents"
      },
      {
        "header": "subject",
        "not_contains": "policy"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 365,
      "do": [
        {
          "type": "move",
          "target": "Newsletters/Marketing/Home/Homeprotect"
        }
      ]
    },
    {
      "age_days_gt": 365,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Homeprotect marketing/newsletter emails — policy documents remain in Property/21 Cleveland Street/Insurance"
  ]
}