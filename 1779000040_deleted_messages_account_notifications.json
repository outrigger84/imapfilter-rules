{
  "name": "Account Notifications >> Deleted Messages",
  "enabled": true,
  "priority": 500,
  "conditions": {
    "all": [
      {
        "header": "subject",
        "regex": "(?i)\\b(login|log in|sign in|signin|unusual activity|security alert|new device|account activity|username)\\b"
      },
      {
        "header": "subject",
        "not_regex": "(?i)account activity (statement|report|summary|digest)"
      },
      {
        "header": "subject",
        "not_regex": "(?i)\\b(vulnerability|CVE|DNS|exploit|advisory|patch)\\b"
      },
      {
        "header": "subject",
        "not_regex": "(?i)\\bDSM\\b"
      },
      {
        "header": "from",
        "not_contains": "sj.gibson@mac.com"
      },
      {
        "header": "from",
        "not_contains": "sj.gibson@me.com"
      },
      {
        "age_days_gt": 14
      }
    ]
  },
  "comments": [
    "Cleanup of account and security notification emails after 14 days",
    "2026-08-18: excluded self-sent mail (sj.gibson@mac.com / @me.com) after the",
    "'login'/'sign in' keyword regex was catching self-forwarded/replied threads",
    "like 'Fwd: Login issues' and 'Re: Xibo Login' — personal correspondence, not",
    "an automated account-security notification."
  ],
  "actions": [
    {
      "type": "move",
      "target": "Deleted Messages"
    }
  ]
}
