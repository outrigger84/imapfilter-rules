{
  "name": "Notifications » Travel » Booking-com",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "noreply-invalidcc@booking.com"
      },
      {
        "header": "from",
        "contains": "cs-noreply@booking.com"
      },
      {
        "header": "from",
        "contains": "noreply@booking.com"
      },
      {
        "header": "from",
        "contains": "noreply-payments@booking.com"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 30,
      "do": [
        {
          "type": "move",
          "target": "Notifications/Travel/Booking-com"
        }
      ]
    },
    {
      "age_days_gt": 30,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard"
  ]
}