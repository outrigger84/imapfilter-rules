{
  "name": "Notifications » Services » Patreon",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "all": [
      {
        "header": "subject",
        "not_equals": "Your Patreon receipt is here!"
      },
      {
        "any": [
          {
            "header": "from",
            "contains": "@patreon.com"
          },
          {
            "header": "from",
            "contains": "@email.patreon.com"
          },
          {
            "header": "from",
            "contains": "_at_patreon_com_"
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Notifications/Services/Patreon"
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard"
  ]
}