{
  "name": "Notifications » Services » Patreon",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "all": [
      {
        "header": "subject",
        "not_equals": "Your Patreon receipt is here!"
      },
      {
        "any": [
          {
            "header": "from",
            "regex": "@([a-z0-9-]+\\.)?patreon\\.com\\b"
          },
          {
            "header": "from",
            "contains": "_at_patreon_com_"
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Notifications/Services/Patreon"
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard",
    "Fixed 2026-08-13 (cache.db analysis): 'contains @patreon.com' only matched",
    "the bare domain, missing real Patreon subdomains like mailgun.patreon.com",
    "and creator.patreon.com. Regex now covers any patreon.com subdomain."
  ]
}