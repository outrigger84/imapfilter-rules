        "contains": "@trustedshops.com"
      },
      {
        "header": "from",
        "contains": "@trustedshops.de"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 30,
      "do": [
        {
          "type": "move",
          "target": "Notifications/Shopping/Trusted Shops"
