{
  "name": "Newsletters » Marketing » Tech » dbrand",
  "enabled": true,
  "priority": 90,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "robots@dbrand.com"
      },
      {
        "all": [
          {
            "header": "from",
            "contains": "@dbrand.com"
          },
          {
            "header": "subject",
            "not_contains": "Receipt for Order #"
          },
          {
            "header": "subject",
            "not_contains": "Tracking Information"
          },
          {
            "header": "subject",
            "not_contains": "Your dbrand order"
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 365,
      "do": [
        {
          "type": "move",
          "target": "Newsletters/Marketing/Tech/dbrand"
        }
      ]
    },
    {
      "age_days_gt": 365,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Imported from Thunderbird msgFilterRules.dat (commit ea19cd6)",
    "2026-10-15: merged 1767641033_newsletters_marketing_tech_hardware_dbrand.json (folder Newsletters/Marketing/Tech/Hardware/dbrand) into this rule -- same sender/brand filed under two folders."
  ]
}
