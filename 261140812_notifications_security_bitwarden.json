{
  "name": "Notifications » Security » Bitwarden",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "no-reply@bitwarden.eu"
      },
      {
        "header": "from",
        "contains": "upcoming-invoice@bitwarden.com"
      },
      {
        "header": "from",
        "contains": "@bitwarden.com"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 30,
      "do": [
        {
          "type": "move",
          "target": "Notifications/Security/Bitwarden"
        }
      ]
    },
    {
      "age_days_gt": 30,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
