{
  "name": "Notifications \u00bb Apple \u00bb Account",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "@email.apple.com"
      },
      {
        "header": "from",
        "contains": "@apple.com"
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Notifications/Apple/Account"
    },
    {
      "type": "set_keywords",
      "keywords": [
        "Retain365"
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard"
  ]
}
