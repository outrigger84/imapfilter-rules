{
  "name": "Notifications » Mozilla Monitor",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "breach-alerts@mozilla.com"
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Notifications/Mozilla Monitor"
    },
    {
      "type": "set_keywords",
      "keywords": [
        "Retain365"
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard",
    "Firefox Monitor data breach alert notifications"
  ]
}
