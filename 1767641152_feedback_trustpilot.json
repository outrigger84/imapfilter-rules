{
  "name": "Feedback » Trustpilot",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "@trustpilotmail.com"
      },
      {
        "header": "from",
        "contains": "noreply.invitations_at_trustpilotmail_com_"
      }
    ]
  },
  "actions": [
    {
      "age_days_lt": 1,
      "do": []
    },
    {
      "age_days_gte": 1,
      "age_days_lte": 30,
      "do": [
        {
          "type": "move",
          "target": "Feedback/Trustpilot"
        }
      ]
    },
    {
      "age_days_gt": 30,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard"
  ]
}