{
  "name": "Newsletters » Amtrak",
  "priority": 100,
  "conditions": {
    "all": [
      {
        "any": [
          {
            "header": "from",
            "contains": "@e-mail.amtrak.com"
          },
          {
            "header": "from",
            "contains": "@amtrakvacations.com"
          }
        ]
      },
      {
        "all": [
          {
            "header": "subject",
            "not_contains": "Now Arriving:"
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Newsletters/Amtrak"
    },
    {
      "type": "set_keywords",
      "keywords": [
        "Retain365"
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard"
  ]
}
