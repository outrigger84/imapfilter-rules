{
  "name": "Newsletters » Marketing » Entertainment » Comic Con",
  "enabled": true,
  "priority": 90,
  "conditions": {
    "all": [
      {
        "any": [
          {
            "header": "from",
            "contains": "museumops@comic-con.org"
          },
          {
            "header": "from",
            "contains": "donotreply@comic-con.org"
          }
        ]
      },
      {
        "header": "subject",
        "not_regex": "order confirmation|order acknowledgement|purchase is complete|badge confirmation"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 365,
      "do": [
        {
          "type": "move",
          "target": "Newsletters/Marketing/Entertainment/Comic Con"
        }
      ]
    },
    {
      "age_days_gt": 365,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Migrated from Thunderbird msgFilterRules.dat",
    "Excludes ticket/badge purchase emails — those go to Receipts/Events/Comic-Con."
  ]
}
