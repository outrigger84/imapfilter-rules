{
  "name": "Subscriptions \u00bb O2",
  "enabled": true,
  "priority": 90,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "@o2mail.co.uk"
      },
      {
        "header": "from",
        "contains": "@o2.co.uk"
      },
      {
        "header": "from",
        "contains": "o2shop@s-email-o2.co.uk"
      },
      {
        "header": "from",
        "contains": "o2shop@o2.com"
      },
      {
        "header": "from",
        "contains": "o2payments@s-email-o2.co.uk"
      },
      {
        "header": "from",
        "contains": "news@o2-email.co.uk"
      },
      {
        "header": "from",
        "contains": "notification@billing.o2.com"
      },
      {
        "header": "from",
        "contains": "notification@account.o2.com"
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Subscriptions/O2"
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard",
    "2026-08-21: merged 1779000175_o2.json into this rule (same destination",
    "folder, complementary non-overlapping subdomains). Took its priority",
    "(90, was 100)."
  ]
}
