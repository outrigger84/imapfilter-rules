{
  "name": "Notifications » Travel » Aer Lingus",
  "enabled": true,
  "priority": 110,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "securemyaccount@aerlingus.com"
      },
      {
        "header": "from",
        "contains": "remind-username@aerlingus.com"
      },
      {
        "header": "from",
        "contains": "@accounts.aerlingus.com"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 30,
      "do": [
        {
          "type": "move",
          "target": "Notifications/Travel/Aer Lingus"
        }
      ]
    },
    {
      "age_days_gt": 30,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Priority 110: must run before the flights rule which explicitly excludes these addresses",
    "Aer Lingus account security and username reminder emails"
  ]
}