{
  "name": "Newsletters » Marketing » Food » Domino's",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "@email.dominosmarketing.co.uk"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 365,
      "do": [
        {
          "type": "move",
          "target": "Newsletters/Marketing/Food/Domino's"
        }
      ]
    },
    {
      "age_days_gt": 365,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard",
    "Domino's Pizza marketing emails via email.dominosmarketing.co.uk. feedback.dominosmarketing.co.uk already covered by Feedback/Dominos rule."
  ]
}