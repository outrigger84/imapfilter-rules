{
  "name": "Newsletters \u00bb Marketing \u00bb Retail \u00bb General \u00bb eBay",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "ebay@reply2.ebay.co.uk"
      },
      {
        "header": "from",
        "contains": "@ebay.co.uk"
      },
      {
        "header": "from",
        "contains": "@ebay.com"
      },
      {
        "header": "from",
        "contains": "reply.ebay.com"
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Newsletters/Marketing/Retail/General/eBay"
    }
  ],
  "comments": [
    "Migrated from Thunderbird msgFilterRules.dat",
    "2026-08-18: added reply.ebay.com -- the literal 'contains \"@ebay.com\"'",
    "check doesn't match 'ebay@reply.ebay.com' (no '@ebay.com' substring),",
    "the same contains-footgun noted in rules-review-2026-06 memory."
  ]
}