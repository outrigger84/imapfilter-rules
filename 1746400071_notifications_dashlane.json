{
  "name": "Notifications \u00bb Dashlane",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "@supercolonial.com"
      },
      {
        "header": "from",
        "contains": "@ryt.email"
      },
      {
        "header": "from",
        "contains": "@aguerovera.com.ar"
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Notifications/Dashlane"
    },
    {
      "type": "set_keywords",
      "keywords": [
        "Retain365"
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard",
    "Dashlane password manager account notifications (sent from unusual relay domains)"
  ]
}