{
  "name": "Notifications » Finance » Wealthify",
  "enabled": true,
  "priority": 90,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "securemessaging@wealthify.com"
      },
      {
        "header": "from",
        "contains": "@emails.wealthify.com"
      },
      {
        "header": "from",
        "contains": "@service.wealthify.com"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 30,
      "do": [
        {
          "type": "move",
          "target": "Notifications/Finance/Wealthify"
        }
      ]
    },
    {
      "age_days_gt": 30,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard",
    "Merged duplicate rule 1779100167_notifications_finance_wealthify.json (2026-08-13): added sender condition(s) ['@emails.wealthify.com', '@service.wealthify.com']."
  ]
}