{
  "name": "Newsletters » Marketing » Travel » Uber",
  "enabled": true,
  "priority": 90,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "uberone@uber.com"
      },
      {
        "header": "from",
        "contains": "uber@uber.com"
      },
      {
        "header": "from",
        "contains": "noreply@uber.com"
      }
    ]
  },
  "comments": [
    "Created with IMAPFilter Rule Wizard"
  ],
  "actions": [
    {
      "age_days_lte": 365,
      "do": [
        {
          "type": "move",
          "target": "Newsletters/Marketing/Travel/Uber"
        }
      ]
    },
    {
      "age_days_gt": 365,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ]
