{
  "name": "Notifications » Royal Mail",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "@royalmail.com"
      },
      {
        "header": "from",
        "contains": "@e.royalmail.com"
      },
      {
        "header": "from",
        "contains": "_at_royalmail_com_"
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Notifications/Royal Mail"
    },
    {
      "type": "set_keywords",
      "keywords": [
        "Retain30"
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard"
  ]
}
