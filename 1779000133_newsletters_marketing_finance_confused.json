{
  "name": "Newsletters » Marketing » Finance » Confused",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "confused.com"
      },
      {
        "header": "from",
        "contains": "@news.confused.com"
      },
      {
        "header": "from",
        "contains": "@reminders.confused.com"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 365,
      "do": [
        {
          "type": "move",
          "target": "Newsletters/Marketing/Finance/Confused"
        }
      ]
    },
    {
      "age_days_gt": 365,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Imported from Thunderbird msgFilterRules.dat (commit ea19cd6)",
    "2026-10-15: merged 1777106918_newsletters_marketing_finance_confused_com.json (folder Newsletters/Marketing/Finance/Confused-com) into this rule -- same sender/brand filed under two folders."
  ]
}
