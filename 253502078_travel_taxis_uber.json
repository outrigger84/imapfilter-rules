{
  "name": "Travel » Taxis » Uber",
  "enabled": true,
  "priority": 85,
  "conditions": {
    "all": [
      {
        "any": [
          {
            "header": "from",
            "contains": "noreply@uber.com"
          },
          {
            "header": "from",
            "contains": "uber.uk@uber.com"
          }
        ]
      },
      {
        "any": [
          {
            "header": "subject",
            "contains": "trip with Uber"
          },
          {
            "header": "subject",
            "contains": "Reservation confirmed"
          },
          {
            "header": "subject",
            "contains": "Your receipt"
          }
        ]
      }
    ]
  },
  "comments": [
    "Created with IMAPFilter Rule Wizard",
    "Priority 85 so trip receipts beat Newsletters » Marketing » Travel » Uber (p90, same senders)"
  ],
  "actions": [
    {
      "type": "move",
      "target": "Travel/Taxis/Uber"
    }
  ]
}
