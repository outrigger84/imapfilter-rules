{
  "name": "Newsletters » Marketing » Food » Papa John's",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "offers@e-papajohns.co.uk"
      },
      {
        "header": "from",
        "contains": "@order.papajohns.co.uk"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 365,
      "do": [
        {
          "type": "move",
          "target": "Newsletters/Marketing/Food/Papa John's"
        }
      ]
    },
    {
      "age_days_gt": 365,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard",
    "Papa John's marketing/offers emails (offers@e-papajohns.co.uk). Receipts from service@e-papajohns.co.uk handled by a separate rule."
  ]
}