{
  "name": "Notifications \u00bb American Express",
  "enabled": false,
  "priority": 100,
  "conditions": {
    "all": [
      {
        "any": [
          {
            "header": "from",
            "contains": "@welcome.americanexpress.com"
          },
          {
            "header": "from",
            "contains": "@welcome.aexp.com"
          }
        ]
      },
      {
        "header": "subject",
        "not_contains": "Your SafeKey Verification Code"
      },
      {
        "header": "subject",
        "not_contains": "Your latest statement is ready"
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Notifications/American Express"
    },
    {
      "type": "set_keywords",
      "keywords": [
        "Retain30"
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard"
  ]
}