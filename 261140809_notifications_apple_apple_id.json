{
  "name": "Notifications » Apple » Apple ID",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "appleid@id.apple.com"
      },
      {
        "header": "from",
        "contains": "@email.apple.com"
      },
      {
        "header": "from",
        "contains": "@apple.com"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 30,
      "do": [
        {
          "type": "move",
          "target": "Notifications/Apple/Apple ID"
        }
      ]
    },
    {
      "age_days_gt": 30,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Migrated from Thunderbird msgFilterRules.dat"
  ]
}