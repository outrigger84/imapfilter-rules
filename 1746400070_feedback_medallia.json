{
  "name": "Feedback \u00bb Medallia",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "@express.ger.medallia.eu"
      },
      {
        "header": "from",
        "contains": "@medallia.eu"
      },
      {
        "header": "from",
        "contains": "@medallia.com"
      },
      {
        "header": "from",
        "contains": "@express.medallia.com"
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Feedback/Medallia"
    }
  ],
  "comments": [
    "Customer experience survey platform",
    "Created with IMAPFilter Rule Wizard",
    "2026-08-21: merged 1777452205_feedback_virgin_atlantic.json into this rule",
    "(same destination folder, complementary conditions). This file was disabled",
    "while its sibling was enabled -- re-enabled to avoid silently dropping",
    "Medallia coverage when the sibling is removed."
  ]
}
