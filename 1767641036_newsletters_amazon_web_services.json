{
  "name": "Newsletters \u00bb Amazon Web Services",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "aws-marketing-email-replies@amazon.com"
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Newsletters/Amazon Web Services"
    },
    {
      "type": "set_keywords",
      "keywords": [
        "Retain365"
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard"
  ]
}