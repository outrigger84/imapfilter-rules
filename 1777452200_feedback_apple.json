{
  "name": "Feedback » Apple",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "all": [
      {
        "header": "from",
        "contains": "@insideapple.apple.com"
      },
      {
        "header": "from",
        "not_contains": "newsdigest@insideapple.apple.com"
      },
      {
        "header": "from",
        "not_contains": "developer@insideapple.apple.com"
      }
    ]
  },
  "actions": [
    {
      "age_days_lt": 1,
      "do": []
    },
    {
      "age_days_gte": 1,
      "age_days_lte": 30,
      "do": [
        {
          "type": "move",
          "target": "Feedback/Apple"
        }
      ]
    },
    {
      "age_days_gt": 30,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard"
  ]
}