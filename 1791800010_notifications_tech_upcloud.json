{
  "name": "Notifications » Tech » UpCloud",
  "enabled": true,
  "priority": 90,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "noreply@upcloud.com"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 30,
      "do": [
        {
          "type": "move",
          "target": "Notifications/Tech/UpCloud"
        }
      ]
    },
    {
      "age_days_gt": 30,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "2026-10-11: UpCloud account/billing notices (Lack of Funds Warning, automated billing confirmations) kept permanently. Priority 90 beats the UpCloud newsletter rule."
  ]
}
