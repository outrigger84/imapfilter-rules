{
  "name": "Newsletters \u00bb Marketing \u00bb Tech \u00bb Bitnami",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "@bitnami.com"
      },
      {
        "header": "from",
        "contains": "@broadcom.com"
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Newsletters/Marketing/Tech/Bitnami"
    },
    {
      "type": "set_keywords",
      "keywords": [
        "Retain365"
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard",
    "Bitnami (now Broadcom) application packaging newsletters"
  ]
}