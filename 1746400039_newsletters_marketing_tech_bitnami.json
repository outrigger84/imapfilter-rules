{
  "name": "Newsletters » Marketing » Tech » Bitnami",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "@bitnami.com"
      },
      {
        "header": "from",
        "contains": "@broadcom.com"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 365,
      "do": [
        {
          "type": "move",
          "target": "Newsletters/Marketing/Tech/Bitnami"
        }
      ]
    },
    {
      "age_days_gt": 365,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard",
    "Bitnami (now Broadcom) application packaging newsletters"
  ]
}