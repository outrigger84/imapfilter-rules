{
  "name": "Personal \u00bb Finance \u00bb Store Credit \u00bb Paypal",
  "enabled": false,
  "priority": 90,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "service@paypal.co.uk"
      },
      {
        "header": "from",
        "contains": "service@paypal.com.hk"
      },
      {
        "header": "from",
        "contains": "paypalcredit@paypal.com"
      },
      {
        "header": "from",
        "contains": "paypalcredit@mail.paypal.co.uk"
      },
      {
        "header": "from",
        "contains": "paypal@paypal.com"
      },
      {
        "header": "from",
        "contains": "@service.paypal.com"
      }
    ]
  },
  "comments": [
    "Created with IMAPFilter Rule Wizard"
  ],
  "actions": [
    {
      "type": "move",
      "target": "Personal/Finance/Store Credit/Paypal"
    }
  ]
}
