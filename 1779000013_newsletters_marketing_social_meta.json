{
  "name": "Newsletters » Marketing » Social » Meta",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "@global.metamail.com"
      },
      {
        "header": "from",
        "contains": "@metamail.com"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 365,
      "do": [
        {
          "type": "move",
          "target": "Newsletters/Marketing/Social/Meta"
        }
      ]
    },
    {
      "age_days_gt": 365,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Facebook/Instagram marketing emails via Meta's metamail.com domain"
  ]
}