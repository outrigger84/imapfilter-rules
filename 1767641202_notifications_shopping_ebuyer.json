{
  "name": "Notifications » Shopping » Ebuyer",
  "enabled": true,
  "priority": 90,
  "conditions": {
    "all": [
      {
        "header": "from",
        "contains": "no-reply@ebuyer.com"
      },
      {
        "header": "subject",
        "contains": "Ebuyer Order No:"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 30,
      "do": [
        {
          "type": "move",
          "target": "Notifications/Shopping/Ebuyer"
        }
      ]
    },
    {
      "age_days_gt": 30,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Order transactional emails (Payment Processed, Items Dispatched, etc.) split from newsletter rule"
  ]
}