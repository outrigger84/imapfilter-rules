{
  "name": "Notifications » Apple » Subscriptions",
  "enabled": true,
  "priority": 90,
  "conditions": {
    "all": [
      {
        "header": "from",
        "contains": "no_reply@email.apple.com"
      },
      {
        "header": "subject",
        "contains": "Your Subscription"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 30,
      "do": [
        {
          "type": "move",
          "target": "Notifications/Apple/Subscriptions"
        }
      ]
    },
    {
      "age_days_gt": 30,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard"
  ]
}