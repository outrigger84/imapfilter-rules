{
  "name": "Newsletters » Amazon",
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "store-news@amazon"
      },
      {
        "header": "from",
        "contains": "amazon-offers@amazon"
      },
      {
        "header": "from",
        "contains": "prime@amazon"
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Newsletters/Amazon"
    },
    {
      "type": "set_keywords",
      "keywords": [
        "Retain365"
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard"
  ]
}
