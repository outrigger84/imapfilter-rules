{
  "name": "Newsletters » Marketing » Retail » General » Amazon",
  "enabled": false,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "store-news@amazon"
      },
      {
        "header": "from",
        "contains": "amazon-offers@amazon"
      },
      {
        "header": "from",
        "contains": "no-reply@business.amazon"
      },
      {
        "header": "from",
        "contains": "vfe-campaign-response@amazon.com"
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Newsletters/Marketing/Retail/General/Amazon"
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard"
  ]
}
