{
  "name": "Receipts \u00bb Amazon",
  "enabled": false,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "auto-confirm@amazon.co.uk"
      },
      {
        "header": "from",
        "contains": "return@amazon.co.uk"
      },
      {
        "header": "from",
        "contains": "payments-messages@amazon.co.uk"
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Receipts/Amazon"
    }
  ],
  "comments": [
    "Migrated from Thunderbird msgFilterRules.dat"
  ]
}