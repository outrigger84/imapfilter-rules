{
  "name": "Receipts » Services » Patreon",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "all": [
      {
        "header": "subject",
        "equals": "Your Patreon receipt is here!"
      },
      {
        "any": [
          {
            "header": "from",
            "contains": "@patreon.com"
          },
          {
            "header": "from",
            "contains": "_patreon_com_"
          }
        ]
      }
    ]
  },
  "comments": [
    "Created with IMAPFilter Rule Wizard",
    "Fixed 2026-08-13: previous 'all' block required @patreon.com AND _patreon_com_ simultaneously, which is never true for a real sender -- receipts never matched."
  ],
  "actions": [
    {
      "type": "move",
      "target": "Receipts/Services/Patreon"
    }
  ]
}
