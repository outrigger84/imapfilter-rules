{
  "name": "Receipts » Retail » Nike",
  "enabled": true,
  "priority": 90,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "@notifications.nike.com"
      },
      {
        "all": [
          {
            "header": "from",
            "contains": "@official.nike.com"
          },
          {
            "any": [
              {
                "header": "subject",
                "contains": "Order"
              },
              {
                "header": "subject",
                "contains": "Refund"
              }
            ]
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Receipts/Retail/Nike"
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard",
    "Added @official.nike.com order/refund mail and raised priority 110 -> 90 (2026-10-03): it previously lost to the Nike newsletter rule (priority 100, 365-day expiry)"
  ]
}
