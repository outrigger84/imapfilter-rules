{
  "name": "Notifications » Security » Dashlane",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "@supercolonial.com"
      },
      {
        "header": "from",
        "contains": "@ryt.email"
      },
      {
        "header": "from",
        "contains": "@aguerovera.com.ar"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 30,
      "do": [
        {
          "type": "move",
          "target": "Notifications/Security/Dashlane"
        }
      ]
    },
    {
      "age_days_gt": 30,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard",
    "Dashlane password manager account notifications (sent from unusual relay domains)"
  ]
}