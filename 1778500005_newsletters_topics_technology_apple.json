{
  "name": "Newsletters » Topics » Technology » Apple",
  "enabled": true,
  "priority": 90,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "newsdigest@insideapple.apple.com"
      },
      {
        "header": "from",
        "contains": "developer@insideapple.apple.com"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 365,
      "do": [
        {
          "type": "move",
          "target": "Newsletters/Topics/Technology/Apple"
        }
      ]
    },
    {
      "age_days_gt": 365,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Apple news digest and developer newsletters — excluded from Feedback/Apple Support rule"
  ]
}