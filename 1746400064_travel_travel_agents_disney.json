{
  "name": "Travel » Travel Agents » Disney",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "@disneyinternational.com"
      },
      {
        "header": "from",
        "contains": "@disneyholidays.co.uk"
      },
      {
        "header": "from",
        "contains": "@mail.disney.co.uk"
      },
      {
        "header": "from",
        "contains": "@experience.disneydestinations.com"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 365,
      "do": [
        {
          "type": "move",
          "target": "Travel/Travel Agents/Disney"
        }
      ]
    },
    {
      "age_days_gt": 365,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard",
    "Walt Disney Travel Company holiday invoices and booking confirmations"
  ]
}
