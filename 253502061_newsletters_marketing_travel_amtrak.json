{
  "name": "Newsletters » Marketing » Travel » Amtrak",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "all": [
      {
        "any": [
          {
            "header": "from",
            "contains": "@e-mail.amtrak.com"
          },
          {
            "header": "from",
            "contains": "@amtrakvacations.com"
          }
        ]
      },
      {
        "all": [
          {
            "header": "subject",
            "not_contains": "Now Arriving:"
          }
        ]
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 365,
      "do": [
        {
          "type": "move",
          "target": "Newsletters/Marketing/Travel/Amtrak"
        }
      ]
    },
    {
      "age_days_gt": 365,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard"
  ]
}