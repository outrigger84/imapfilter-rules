{
  "name": "Feedback \u00bb SurveyMonkey",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "@surveymonkeyuser.com"
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Feedback/SurveyMonkey"
    },
    {
      "type": "set_keywords",
      "keywords": [
        "Retain365"
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard",
    "SurveyMonkey survey invitations sent by various businesses"
  ]
}