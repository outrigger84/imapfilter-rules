{
  "name": "Notifications \u00bb Google",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "@google.com"
      },
      {
        "header": "from",
        "contains": "@accounts.google.com"
      }
    ]
  },
  "actions": [
    {
      "type": "move",
      "target": "Notifications/Google"
    },
    {
      "type": "set_keywords",
      "keywords": [
        "Retain30"
      ]
    }
  ],
  "comments": [
    "Created with IMAPFilter Rule Wizard"
  ]
}