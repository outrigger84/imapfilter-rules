{
  "name": "Notifications » Government » gov-uk",
  "enabled": true,
  "priority": 100,
  "conditions": {
    "any": [
      {
        "header": "from",
        "contains": "no-reply@access.service.gov.uk"
      },
      {
        "header": "from",
        "contains": "noreply@tax.service.gov.uk"
      }
    ]
  },
  "actions": [
    {
      "age_days_lte": 30,
      "do": [
        {
          "type": "move",
          "target": "Notifications/Government/gov-uk"
        }
      ]
    },
    {
      "age_days_gt": 30,
      "do": [
        {
          "type": "move",
          "target": "Deleted Messages"
        }
      ]
    }
  ],
  "comments": [
    "Migrated from Thunderbird msgFilterRules.dat"
  ]
}